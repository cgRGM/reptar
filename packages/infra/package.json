{
  "name": "@reptar/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "alchemy dev",
    "build:workers": "bun ../../scripts/reptar.ts build:worker && bun ../../scripts/reptar.ts build:realworld && bun ../../scripts/reptar.ts build:worker:rooms",
    "deploy": "bun run build:workers && alchemy deploy -y",
    "destroy": "alchemy destroy"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@reptar/config": "workspace:*",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.5",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
