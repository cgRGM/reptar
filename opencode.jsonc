{
  "mcp": {
    "better-t-stack": {
      "type": "local",
      "command": ["bunx", "create-better-t-stack@latest", "mcp"],
      "environment": {},
      "enabled": true,
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "environment": {},
      "enabled": true,
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true,
    },
    "astro-docs": {
      "type": "remote",
      "url": "https://mcp.docs.astro.build/mcp",
      "enabled": true,
    },
  },
}
