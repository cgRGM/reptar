{
  "name": "reptar-netwasm-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./public",
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reptar-spike",
      "database_id": "11111111-1111-1111-1111-111111111111",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "reptar-blog-images",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "reptar-local-kv",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "reptar-events",
      },
    ],
  },
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTER",
        "class_name": "Counter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Counter"],
    },
  ],
  "vars": {
    "APP_NAME": "reptar-local",
    "CORS_ORIGINS": "http://localhost:4321",
  },
}
