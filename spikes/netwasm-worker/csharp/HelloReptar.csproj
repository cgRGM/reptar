<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <OutputType>JsModule</OutputType>
    <NetWasmJavaScriptHosts>page</NetWasmJavaScriptHosts>
    <TargetFramework>netwasm0.1</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NetWasmOptimization>O0</NetWasmOptimization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../framework/Reptar.Wasm/Reptar.Wasm.csproj" />
    <Compile Include="../../../examples/blog/schema/posts.cs" />
    <Compile Include="../../../examples/blog/schema/index.cs" />
    <Compile Include="../../../examples/blog/features/posts.cs" />
    <Compile Include="../../../examples/blog/features/blog.cs" />
  </ItemGroup>
  <ItemGroup>
    <NetWasmJavaScriptModule Include="app.host.mjs" Module="app.host" />
  </ItemGroup>
</Project>
