---
import Layout from "../layouts/layout.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8788";
---

<Layout
  title="Sign in — Reptar"
  description="Sign in to your account powered by Reptar's built-in C# auth running on Cloudflare Workers."
>
  <div class="flex min-h-[calc(100vh-3.5rem)]">
    <!-- Left column: Form -->
    <div class="flex flex-1 flex-col justify-center px-4 py-12 sm:px-6 lg:flex-none lg:px-20 xl:px-24 bg-[#090a0c]">
      <div class="mx-auto w-full max-w-sm lg:w-96">
        <div>
          <a href="/" class="flex items-center gap-2.5 group inline-flex" aria-label="Reptar Home">
            <svg class="h-8 w-8 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M21 4h-6v2h-2v2h-2V6H9V4H5v4h2v4h2v2H7v2H5v2H3v4h4v-2h2v-2h2v-2h2v4h2v-4h2v-2h2v-4h2V8h-2V6h2V4z" />
            </svg>
            <span class="font-bold tracking-tight text-white text-xl">reptar</span>
            <span class="rounded bg-[#15181e] px-1.5 py-0.5 font-mono text-[11px] font-medium text-zinc-400 border border-[#232730]">
              auth
            </span>
          </a>

          <h1 id="auth-title" class="mt-8 text-2xl font-bold tracking-tight text-white">
            Sign in to your account
          </h1>
          <p class="mt-2 text-sm text-zinc-400">
            <span id="auth-switch-prompt">Not a member?</span>
            <button
              type="button"
              id="auth-mode-toggle"
              class="font-semibold text-emerald-400 hover:text-emerald-300 ml-1 underline underline-offset-4 focus:outline-none"
            >
              Create an account
            </button>
          </p>
        </div>

        <div class="mt-8">
          <div id="auth-error" class="hidden mb-4 rounded border border-red-900/60 bg-red-950/30 p-3 text-xs text-red-300"></div>

          <form id="auth-form" class="space-y-5">
            <div id="name-group" class="hidden">
              <label for="name" class="block text-xs font-mono uppercase tracking-wider text-zinc-400">
                Full Name
              </label>
              <div class="mt-1.5">
                <input
                  id="name"
                  type="text"
                  name="name"
                  autocomplete="name"
                  placeholder="Demo User"
                  class="block w-full rounded border border-[#232730] bg-[#111317] px-3 py-2 text-sm text-white placeholder:text-zinc-600 outline-none focus:border-emerald-500 transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-xs font-mono uppercase tracking-wider text-zinc-400">
                Email address
              </label>
              <div class="mt-1.5">
                <input
                  id="email"
                  type="email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="demo@reptar.dev"
                  class="block w-full rounded border border-[#232730] bg-[#111317] px-3 py-2 text-sm text-white placeholder:text-zinc-600 outline-none focus:border-emerald-500 transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="password" class="block text-xs font-mono uppercase tracking-wider text-zinc-400">
                Password
              </label>
              <div class="mt-1.5">
                <input
                  id="password"
                  type="password"
                  name="password"
                  required
                  autocomplete="current-password"
                  placeholder="••••••••••••"
                  class="block w-full rounded border border-[#232730] bg-[#111317] px-3 py-2 text-sm text-white placeholder:text-zinc-600 outline-none focus:border-emerald-500 transition-colors"
                />
              </div>
            </div>

            <div class="flex items-center justify-between text-xs">
              <label class="flex items-center gap-2 cursor-pointer text-zinc-400">
                <input
                  id="remember-me"
                  type="checkbox"
                  name="remember-me"
                  checked
                  class="rounded border-[#232730] bg-[#111317] text-emerald-500 focus:ring-0 focus:ring-offset-0"
                />
                <span>Remember me</span>
              </label>

              <a href="#" class="font-medium text-zinc-400 hover:text-white transition-colors">
                Forgot password?
              </a>
            </div>

            <div>
              <button
                type="submit"
                id="submit-btn"
                class="flex w-full justify-center rounded bg-emerald-500 px-4 py-2.5 text-xs font-semibold text-zinc-950 uppercase tracking-wider font-mono hover:bg-emerald-400 focus:outline-none transition-colors"
              >
                Sign in
              </button>
            </div>
          </form>

          <div class="mt-8">
            <div class="relative">
              <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-[#232730]"></div>
              </div>
              <div class="relative flex justify-center text-xs font-mono uppercase tracking-wider">
                <span class="bg-[#090a0c] px-3 text-zinc-500">Or continue with</span>
              </div>
            </div>

            <div class="mt-6 grid grid-cols-2 gap-3">
              <button
                type="button"
                id="guest-btn"
                class="col-span-2 flex w-full items-center justify-center gap-2 rounded border border-[#232730] bg-[#111317] px-3 py-2 text-xs font-medium text-zinc-300 hover:bg-[#161a22] hover:text-white transition-colors"
              >
                <svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span>Continue as Guest (Anonymous)</span>
              </button>

              <button
                type="button"
                disabled
                title="OAuth adapter integration in progress"
                class="flex w-full items-center justify-center gap-2 rounded border border-[#232730] bg-[#111317] px-3 py-2 text-xs font-medium text-zinc-500 opacity-60 cursor-not-allowed"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4">
                  <path d="M12.0003 4.75C13.7703 4.75 15.3553 5.36002 16.6053 6.54998L20.0303 3.125C17.9502 1.19 15.2353 0 12.0003 0C7.31028 0 3.25527 2.69 1.28027 6.60998L5.27028 9.70498C6.21525 6.86002 8.87028 4.75 12.0003 4.75Z" fill="#EA4335" />
                  <path d="M23.49 12.275C23.49 11.49 23.415 10.73 23.3 10H12V14.51H18.47C18.18 15.99 17.34 17.25 16.08 18.1L19.945 21.1C22.2 19.01 23.49 15.92 23.49 12.275Z" fill="#4285F4" />
                  <path d="M5.26498 14.2949C5.02498 13.5699 4.88501 12.7999 4.88501 11.9999C4.88501 11.1999 5.01998 10.4299 5.26498 9.7049L1.275 6.60986C0.46 8.22986 0 10.0599 0 11.9999C0 13.9399 0.46 15.7699 1.28 17.3899L5.26498 14.2949Z" fill="#FBBC05" />
                  <path d="M12.0004 24.0001C15.2404 24.0001 17.9654 22.935 19.9454 21.095L16.0804 18.095C15.0054 18.82 13.6204 19.245 12.0004 19.245C8.8704 19.245 6.21537 17.135 5.2654 14.29L1.27539 17.385C3.25539 21.31 7.3104 24.0001 12.0004 24.0001Z" fill="#34A853" />
                </svg>
                <span>Google</span>
              </button>

              <button
                type="button"
                disabled
                title="OAuth adapter integration in progress"
                class="flex w-full items-center justify-center gap-2 rounded border border-[#232730] bg-[#111317] px-3 py-2 text-xs font-medium text-zinc-500 opacity-60 cursor-not-allowed"
              >
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-4 w-4 fill-zinc-400">
                  <path d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd" fill-rule="evenodd" />
                </svg>
                <span>GitHub</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right column: Architecture / Code Showcase -->
    <div class="relative hidden w-0 flex-1 lg:flex flex-col justify-center border-l border-[#232730] bg-[#0c0d11] p-12">
      <div class="max-w-xl mx-auto space-y-6">
        <div>
          <span class="font-mono text-xs text-emerald-400 uppercase tracking-wider font-semibold">
            Reptar.Auth Architecture
          </span>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-white">
            Built-in C# auth, running on Cloudflare Workers.
          </h2>
          <p class="mt-3 text-xs text-zinc-400 leading-relaxed">
            Passwords hashed via host WebCrypto scrypt. 32-byte cryptographically secure session tokens stored in D1 as SHA-256 hashes. Verified via HttpOnly SameSite cookies.
          </p>
        </div>

        <!-- Code Block -->
        <div class="rounded border border-[#232730] bg-[#111317] overflow-hidden">
          <div class="border-b border-[#232730] bg-[#15181e] px-4 py-2 flex items-center justify-between">
            <span class="font-mono text-xs text-zinc-400">apps/api/features/posts.cs</span>
            <span class="font-mono text-[10px] text-emerald-400 uppercase">Protected Route</span>
          </div>
          <pre class="p-4 font-mono text-xs text-zinc-300 leading-relaxed overflow-x-auto"><code><span class="text-zinc-500">// Require authenticated user session</span>
app.Post(<span class="text-amber-300">"/posts"</span>, Auth.RequireUser, CreateSchema, <span class="text-emerald-400">async</span> (ctx, input) =&gt;
&#123;
    <span class="text-emerald-400">var</span> post = <span class="text-emerald-400">new</span> Post(
        Id: Ids.New(<span class="text-amber-300">"post"</span>),
        AuthorId: ctx.User!.Id, <span class="text-zinc-500">// Guaranteed non-null</span>
        Title: input.Title.Trim(),
        Content: input.Content,
        CreatedAt: ctx.Clock.IsoNow()
    );

    <span class="text-emerald-400">await</span> ctx.Db.InsertAsync(Schema.Posts, post);
    <span class="text-emerald-400">return</span> ctx.Json(post, 201);
&#125;);</code></pre>
        </div>

        <!-- Security Specs Grid -->
        <div class="grid grid-cols-2 gap-3 pt-2">
          <div class="rounded border border-[#232730] bg-[#111317] p-3">
            <div class="font-mono text-[11px] text-zinc-500 uppercase">Hash Engine</div>
            <div class="mt-1 font-mono text-xs text-white">Native Host Scrypt</div>
          </div>
          <div class="rounded border border-[#232730] bg-[#111317] p-3">
            <div class="font-mono text-[11px] text-zinc-500 uppercase">Session Store</div>
            <div class="mt-1 font-mono text-xs text-white">D1 SQLite (SHA-256)</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ apiUrl }}>
    let isSignUp = false;

    const titleEl = document.querySelector("#auth-title");
    const switchPromptEl = document.querySelector("#auth-switch-prompt");
    const modeToggleBtn = document.querySelector("#auth-mode-toggle");
    const nameGroup = document.querySelector("#name-group");
    const submitBtn = document.querySelector("#submit-btn");
    const form = document.querySelector("#auth-form");
    const errorEl = document.querySelector("#auth-error");
    const guestBtn = document.querySelector("#guest-btn");

    modeToggleBtn?.addEventListener("click", () => {
      isSignUp = !isSignUp;

      if (isSignUp) {
        titleEl.textContent = "Create an account";
        switchPromptEl.textContent = "Already have an account?";
        modeToggleBtn.textContent = "Sign in";
        nameGroup.classList.remove("hidden");
        submitBtn.textContent = "Create Account";
      } else {
        titleEl.textContent = "Sign in to your account";
        switchPromptEl.textContent = "Not a member?";
        modeToggleBtn.textContent = "Create an account";
        nameGroup.classList.add("hidden");
        submitBtn.textContent = "Sign in";
      }

      errorEl.classList.add("hidden");
    });

    const showError = (msg) => {
      errorEl.textContent = msg;
      errorEl.classList.remove("hidden");
    };

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.classList.add("hidden");
      submitBtn.disabled = true;
      submitBtn.textContent = isSignUp ? "Creating…" : "Signing in…";

      const data = new FormData(form);
      const email = String(data.get("email") ?? "").trim();
      const password = String(data.get("password") ?? "");
      const name = String(data.get("name") ?? "").trim() || "User";

      const endpoint = isSignUp ? `${apiUrl}/auth/signup` : `${apiUrl}/auth/signin`;
      const payload = isSignUp ? { email, name, password } : { email, password };

      try {
        const res = await fetch(endpoint, {
          body: JSON.stringify(payload),
          credentials: "include",
          headers: { "content-type": "application/json" },
          method: "POST",
        });

        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          const message = body.message || body.error || `Authentication failed (${res.status})`;
          showError(message);
          submitBtn.disabled = false;
          submitBtn.textContent = isSignUp ? "Create Account" : "Sign in";
          return;
        }

        // Successfully authenticated! Redirect to /blog
        window.location.href = "/blog";
      } catch (error) {
        showError(error instanceof Error ? error.message : "Failed to connect to auth server.");
        submitBtn.disabled = false;
        submitBtn.textContent = isSignUp ? "Create Account" : "Sign in";
      }
    });

    guestBtn?.addEventListener("click", async () => {
      guestBtn.disabled = true;
      guestBtn.textContent = "Creating guest session…";

      try {
        const res = await fetch(`${apiUrl}/auth/anonymous`, {
          credentials: "include",
          method: "POST",
        });

        if (!res.ok) {
          showError("Could not create anonymous guest session.");
          guestBtn.disabled = false;
          guestBtn.textContent = "Continue as Guest (Anonymous)";
          return;
        }

        window.location.href = "/blog";
      } catch (error) {
        showError(error instanceof Error ? error.message : "Network error.");
        guestBtn.disabled = false;
        guestBtn.textContent = "Continue as Guest (Anonymous)";
      }
    });
  </script>
</Layout>
