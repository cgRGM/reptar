---
const targets = [
  {
    badge: "Shipped & Verified",
    badgeColor: "text-emerald-400 border-emerald-500/30 bg-emerald-500/10",
    id: "01",
    metrics: [
      { label: "Isolate Execution", value: "<2ms" },
      { label: "Cold Start", value: "<50ms" },
    ],
    name: "Cloudflare Workers",
    runtime: "NetWasm 0.1 / Edge Isolate",
    summary:
      "Compiled to WebAssembly via NetWasm. Executes inside V8 worker isolates with direct bindings to D1 relational SQLite, R2 object storage, KV, Queues, and Workers AI.",
  },
  {
    badge: "Shipped (Native AOT)",
    badgeColor: "text-emerald-400 border-emerald-500/30 bg-emerald-500/10",
    id: "02",
    metrics: [
      { label: "Binary Footprint", value: "17.1 MB" },
      { label: "Process Boot", value: "<5ms" },
    ],
    name: "Docker & Linux VPS",
    runtime: "Distroless Linux Container",
    summary:
      "Self-contained Native AOT Linux binary packed into an 18MB distroless image. Runs on any VPS or container platform with PostgreSQL (Npgsql) or SQLite.",
  },
  {
    badge: "Shipped Adapter",
    badgeColor: "text-blue-400 border-blue-500/30 bg-blue-500/10",
    id: "03",
    metrics: [
      { label: "Cold Start", value: "<15ms" },
      { label: "Base Memory", value: "~20 MB" },
    ],
    name: "AWS Lambda",
    runtime: "provided.al2023 Custom Runtime",
    summary:
      "Compiled with .NET Native AOT for AWS custom runtimes or wrapped with @reptar/adapter-lambda. Eliminates standard container overhead and heavy framework tax.",
  },
  {
    badge: "Roadmap / Evaluation",
    badgeColor: "text-zinc-400 border-zinc-500/30 bg-zinc-500/10",
    id: "04",
    metrics: [
      { label: "Contract Sync", value: "Realtime" },
      { label: "Client Schema", value: "Standard Schema" },
    ],
    name: "Vercel & Monorepos",
    runtime: "@reptar/client & Edge Runtime",
    summary:
      "Autonomous contract generation outputs TypeScript clients and Standard Schema validators into TanStack Start, Next.js, and Expo frontends.",
  },
];
---

<section class="border-b border-[#232730] bg-[#090a0c] py-20 lg:py-24" id="usage">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Deployment Target Matrix
      </h2>
      <p class="mt-4 text-base sm:text-lg text-zinc-400 leading-relaxed">
        Write your feature slices once in C#. Compile them to WebAssembly for Cloudflare edge isolates, or to Native AOT for serverless runtimes and distroless containers.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {targets.map((target) => (
        <div class="rounded border border-[#232730] bg-[#111317] p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-zinc-500 uppercase tracking-wider font-semibold">
                Target {target.id}
              </span>
              <span class={`font-mono text-[10px] px-2 py-0.5 rounded border ${target.badgeColor}`}>
                {target.badge}
              </span>
            </div>
            <h3 class="mt-3 text-lg font-semibold text-white">{target.name}</h3>
            <p class="mt-3 text-xs text-zinc-400 leading-relaxed">
              {target.summary}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-[#1a1d24] space-y-3">
            <div class="grid grid-cols-2 gap-2 text-[11px] font-mono">
              {target.metrics.map((metric) => (
                <div class="bg-[#171a20] p-2 rounded border border-[#232730]">
                  <div class="text-zinc-500 text-[10px]">{metric.label}</div>
                  <div class="text-zinc-200 font-semibold mt-0.5">{metric.value}</div>
                </div>
              ))}
            </div>
            <div class="font-mono text-[11px] text-emerald-400">
              {target.runtime}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Verified Performance Evidence -->
    <div class="mt-12 rounded border border-[#232730] bg-[#111317] p-6 lg:p-8">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div class="max-w-2xl">
          <h4 class="text-sm font-semibold uppercase tracking-wider font-mono text-emerald-400">
            Verified Production Telemetry
          </h4>
          <p class="mt-2 text-xs sm:text-sm text-zinc-300 leading-relaxed">
            Directly measured in production Cloudflare isolates: in-memory Wasm execution runs in under 2ms per request (<code class="text-emerald-400 font-mono">server-timing: reptar;dur=0.0</code>). 0 dropped connections under load testing. Relational queries against D1 and PostgreSQL execute with zero runtime reflection.
          </p>
        </div>
        <div class="flex items-center gap-4 shrink-0">
          <a
            href="https://reptar-docs.rocktown-labs.workers.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-4 py-2 text-xs font-semibold text-zinc-950 bg-emerald-500 hover:bg-emerald-400 transition-colors rounded"
          >
            Review Benchmarks & Specs
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
