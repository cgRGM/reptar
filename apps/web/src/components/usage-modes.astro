---
const benchmarks = [
  {
    delta: "+0%",
    hono: "47,298",
    minimal: "41,852",
    reptar: "41,877",
    scenario: "T0 · Plaintext HTTP",
    swr: "—",
  },
  {
    delta: "+1%",
    hono: "39,289",
    minimal: "41,675",
    reptar: "42,239",
    scenario: "T1 · JSON Serialization",
    swr: "—",
  },
  {
    delta: "+1%",
    hono: "34,401",
    minimal: "40,954",
    reptar: "41,355",
    scenario: "T2 · Router & Path Params",
    swr: "—",
  },
  {
    delta: "+5%",
    hono: "18,256",
    minimal: "34,427",
    reptar: "36,262",
    scenario: "T3 · Payload Validation (Rule<T>)",
    swr: "—",
  },
  {
    delta: "+6%",
    hono: "17,909",
    minimal: "12,973",
    reptar: "13,765",
    scenario: "T4 · Task Detail (SQLite Join)",
    swr: "39,214 req/s (2.6ms p50)",
  },
  {
    delta: "+1%",
    hono: "6,753",
    minimal: "5,884",
    reptar: "5,945",
    scenario: "T5 · Task List (20 Rows + Filter)",
    swr: "29,874 req/s (3.3ms p50)",
  },
  {
    delta: "+6%",
    hono: "9,806",
    minimal: "10,126",
    reptar: "10,707",
    scenario: "T6 · Task Comments (Ordered Join)",
    swr: "35,485 req/s (2.8ms p50)",
  },
  {
    delta: "+72%",
    hono: "4,235",
    minimal: "3,628",
    reptar: "6,224",
    scenario: "T7 · Create Task (Group-Commit Write)",
    swr: "—",
  },
  {
    delta: "+6%",
    hono: "12,052",
    minimal: "14,765",
    reptar: "15,683",
    scenario: "T8 · /me (JWT Auth + Single-Row Read)",
    swr: "—",
  },
  {
    delta: "+129%",
    hono: "4,949",
    minimal: "2,150",
    reptar: "4,925",
    scenario: "T10 · Authenticated Update (JWT + Write)",
    swr: "—",
  },
];

const targets = [
  {
    metrics: [
      { label: "Warm Isolate", value: "< 2 ms" },
      { label: "Cached Edge p50", value: "8–9 ms" },
    ],
    name: "Cloudflare Workers",
    runtime: "netwasm0.1 · V8 Isolate",
    status: "Shipped",
    summary:
      "Compiles C# to WebAssembly via NetWasm. Runs inside Cloudflare isolates with in-memory bindings to D1 SQLite, R2 storage, KV, Queues, Durable Objects, and Workers AI.",
  },
  {
    metrics: [
      { label: "AOT Binary", value: "10.4 MB" },
      { label: "Cold Boot", value: "124 ms" },
    ],
    name: "Docker & Linux VPS",
    runtime: "net10.0 · Native AOT",
    status: "Shipped",
    summary:
      "Self-contained Native AOT Linux executable packed into a distroless container. Powered by Kestrel zero-copy PipeReader/PipeWriter with PostgreSQL, MySQL, or WAL SQLite.",
  },
  {
    metrics: [
      { label: "Cold Start", value: "< 15 ms" },
      { label: "Base Memory", value: "~20 MB" },
    ],
    name: "AWS Lambda",
    runtime: "provided.al2023 · Custom Runtime",
    status: "Shipped",
    summary:
      "Native AOT bootstrap loop for AWS Lambda custom runtimes or Node/Wasm adapter via @reptar/adapter-lambda. Eliminates traditional .NET cold-start overhead.",
  },
  {
    metrics: [
      { label: "Conduit Hurl Suite", value: "154 / 154" },
      { label: "Framework Tests", value: "118 / 118" },
    ],
    name: "Fullstack Monorepos",
    runtime: "@reptar/client · OpenAPI 3.1",
    status: "Shipped",
    summary:
      "Generates zero-dependency TypeScript RPC clients, Standard Schema (~standard) validators, and OpenAPI 3.1 specs for React 19, TanStack Start, Next.js, and Astro.",
  },
];
---

<section class="border-b border-[#222630] bg-[#0a0b0e] py-20 lg:py-24" id="benchmarks">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Verified Benchmarks
        </h2>
        <p class="mt-3 text-base sm:text-lg text-zinc-400 leading-relaxed">
          Measured on an isolated 2-vCPU Linux VPS (server pinned to CPU 0, load generator pinned to CPU 1) comparing Reptar Native AOT against .NET 10 Minimal API (Native AOT, raw ADO.NET) and Hono on Bun.
        </p>
      </div>
      <div class="flex items-center gap-6 font-mono text-xs text-zinc-400 border border-[#222630] bg-[#0f1116] px-4 py-2.5">
        <div>Reptar Binary: <span class="text-white font-semibold">10.4 MB</span></div>
        <span class="text-zinc-700">|</span>
        <div>Boot: <span class="text-white font-semibold">124 ms</span></div>
        <span class="text-zinc-700">|</span>
        <div>Hono Bundle: <span class="text-zinc-300">104.3 MB</span></div>
      </div>
    </div>

    <!-- Benchmark Table -->
    <div class="mt-8 border border-[#222630] bg-[#0f1116] overflow-x-auto">
      <table class="w-full text-left border-collapse font-mono text-xs">
        <thead>
          <tr class="border-b border-[#222630] bg-[#13161c] text-zinc-400">
            <th class="py-3.5 px-4 font-semibold">Benchmark Tier</th>
            <th class="py-3.5 px-4 font-semibold text-right text-white">Reptar (req/s)</th>
            <th class="py-3.5 px-4 font-semibold text-right">.NET 10 Minimal API</th>
            <th class="py-3.5 px-4 font-semibold text-right">Hono (Bun)</th>
            <th class="py-3.5 px-4 font-semibold text-right">Reptar + SWR Cache</th>
            <th class="py-3.5 px-4 font-semibold text-right">vs Minimal API</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#1b1f28] text-zinc-300">
          {benchmarks.map((row) => (
            <tr class="hover:bg-[#13161c] transition-colors">
              <td class="py-3 px-4 font-medium text-zinc-200">{row.scenario}</td>
              <td class="py-3 px-4 text-right font-bold text-white">{row.reptar}</td>
              <td class="py-3 px-4 text-right text-zinc-400">{row.minimal}</td>
              <td class="py-3 px-4 text-right text-zinc-400">{row.hono}</td>
              <td class="py-3 px-4 text-right text-emerald-400">{row.swr}</td>
              <td class="py-3 px-4 text-right font-semibold text-zinc-200">{row.delta}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-zinc-500 font-mono">
      <div>
        RealWorld (Conduit) 154/154 Hurl spec also verified on PostgreSQL 14 (102,816 req/s SWR cached reads; 4,664 writes/s via transactional NpgsqlBatch) and Cloudflare Workers + D1.
      </div>
      <a
        href="https://reptar-docs.rocktownlabs.app/overview/realworld"
        target="_blank"
        rel="noopener noreferrer"
        class="text-emerald-400 hover:text-emerald-300 transition-colors whitespace-nowrap"
      >
        Full Benchmark Methodology &rarr;
      </a>
    </div>
  </div>
</section>

<section class="border-b border-[#222630] bg-[#0a0b0e] py-20 lg:py-24" id="usage">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Deployment Targets
      </h2>
      <p class="mt-3 text-base sm:text-lg text-zinc-400 leading-relaxed">
        Write your feature slices once in C#. Compile them to WebAssembly for Cloudflare edge isolates, or to Native AOT for serverless runtimes and distroless containers.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 border border-[#222630] bg-[#0f1116] divide-y md:divide-y-0 md:divide-x divide-[#222630]">
      {targets.map((target) => (
        <div class="p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-base font-semibold text-white">{target.name}</h3>
              <span class="font-mono text-[11px] px-2 py-0.5 border border-[#222630] bg-[#13161c] text-zinc-300">
                {target.status}
              </span>
            </div>
            <p class="mt-3 text-xs text-zinc-400 leading-relaxed">
              {target.summary}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-[#1b1f28] space-y-3">
            <div class="grid grid-cols-2 gap-2 text-[11px] font-mono">
              {target.metrics.map((metric) => (
                <div class="bg-[#13161c] p-2.5 border border-[#222630]">
                  <div class="text-zinc-500 text-[10px]">{metric.label}</div>
                  <div class="text-white font-semibold mt-0.5">{metric.value}</div>
                </div>
              ))}
            </div>
            <div class="font-mono text-[11px] text-zinc-400">
              {target.runtime}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
