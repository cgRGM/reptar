---
---

<section class="border-b border-[#232730] bg-[#090a0c] py-20 lg:py-28" id="overview">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl">
      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-white leading-[1.1]">
        Reptar is the backend.
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-zinc-400 leading-relaxed max-w-3xl">
        A C# web framework that compiles to a small Wasm module and runs on Cloudflare Workers.
        Hono-like routing, Drizzle-like schema, Zod-like validation, built-in auth, native Cloudflare bindings,
        and a generated typed client for any frontend.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="https://reptar-docs.rocktown-labs.workers.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-zinc-950 bg-emerald-500 hover:bg-emerald-400 transition-colors rounded"
        >
          Read the Documentation
        </a>

        <a
          href="https://github.com/RocktownLabs/reptar"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium text-zinc-300 bg-[#111317] border border-[#232730] hover:bg-[#15181e] hover:text-white transition-colors rounded"
        >
          View Source on GitHub
        </a>

        <div class="flex items-center rounded border border-[#232730] bg-[#111317] px-3.5 py-2 font-mono text-xs text-zinc-300">
          <span class="text-zinc-500 select-none mr-2">$</span>
          <span id="install-cmd">bun create reptar@latest</span>
          <button
            type="button"
            id="copy-btn"
            class="ml-3 text-zinc-400 hover:text-emerald-400 focus:outline-none transition-colors"
            title="Copy command to clipboard"
            aria-label="Copy command"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Technical specifications row -->
      <div class="mt-14 pt-8 border-t border-[#1a1d24] grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="border-l border-[#232730] pl-4">
          <div class="text-xs uppercase tracking-wider font-mono text-zinc-500">Host Target</div>
          <div class="mt-1 font-mono text-sm font-medium text-white">NetWasm 0.1 / AOT</div>
        </div>
        <div class="border-l border-[#232730] pl-4">
          <div class="text-xs uppercase tracking-wider font-mono text-zinc-500">Reflection</div>
          <div class="mt-1 font-mono text-sm font-medium text-white">Zero (Source Gen)</div>
        </div>
        <div class="border-l border-[#232730] pl-4">
          <div class="text-xs uppercase tracking-wider font-mono text-zinc-500">Frontend Surface</div>
          <div class="mt-1 font-mono text-sm font-medium text-white">Generated Contracts</div>
        </div>
        <div class="border-l border-[#232730] pl-4">
          <div class="text-xs uppercase tracking-wider font-mono text-zinc-500">Platform Bindings</div>
          <div class="mt-1 font-mono text-sm font-medium text-white">D1, R2, AI, RateLimit</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.querySelector("#copy-btn");
  const installCmd = document.querySelector("#install-cmd")?.textContent ?? "bun create reptar@latest";

  copyBtn?.addEventListener("click", () => {
    navigator.clipboard.writeText(installCmd);
    const originalSvg = copyBtn.innerHTML;
    copyBtn.innerHTML = `
      <svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    `;
    setTimeout(() => {
      copyBtn.innerHTML = originalSvg;
    }, 2000);
  });
</script>
