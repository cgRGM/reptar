---
const features = [
  {
    code: "Reptar is the backend",
    description: "Zero frontend opinions: no UI kit, no styling, and no client router in the framework. The only frontend-facing surface is generated contracts: a typed fetch client, types, Standard Schema, and OpenAPI.",
    icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
    title: "Contract-Driven Architecture",
  },
  {
    code: "DefineTable(\"posts\", ...)",
    description: "Tables are defined in partial Schema classes. This Drizzle-like declaration is the single source of truth for DDL generation, row mappers, parameterized D1 queries, and contract constraints.",
    icon: "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4",
    title: "Schema as Single Source of Truth",
  },
  {
    code: "Rule<T>() + ~standard",
    description: "No Zod on the backend. Source-generated records enforce structure, while Rule<T> validates field constraints and cross-field refinements. Emits zero-dependency ~standard validators for TanStack Form.",
    icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2",
    title: "Zero-Dependency Validation",
  },
  {
    code: "Reptar.Auth + Adapters",
    description: "Built-in C# auth slice: email/password with host native scrypt, 32-byte session tokens stored in D1, HttpOnly cookies, and anonymous sessions. Adapters for Better Auth and Clerk integrate seamlessly.",
    icon: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z",
    title: "Built-in Auth & Adapters",
  },
  {
    code: "c.Db, c.Storage, c.AI",
    description: "Cloudflare bindings are exposed directly to C# handlers through the Ctx surface. D1 uses Dapper-like parameterized queries; R2 handles object storage; Workers AI powers inference.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    title: "Native Cloudflare Bindings",
  },
  {
    code: "reptar db generate / push",
    description: "A self-contained migration engine generates pure SQL DDL directly from your TableDef declarations. Push to local SQLite during development; apply directly to Cloudflare D1 in production.",
    icon: "M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
    title: "Integrated Migrations Engine",
  },
  {
    code: "/_reptar + Server-Timing",
    description: "Observable by default. Every request outputs a structured JSON log line with trace_id, duration_ms, and db_queries. Includes Server-Timing headers, dev metrics dashboard, and native Axiom OTLP export.",
    icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
    title: "Comprehensive Observability",
  },
  {
    code: "NetWasm + Native AOT",
    description: "No runtime reflection or desktop .NET ceremony. Source generators handle JSON serialization and database mapping. The same C# compiles to netwasm0.1 for Workers or net10.0 Native AOT for containers.",
    icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10",
    title: "Dual-Target Compilation",
  },
];
---

<section class="border-b border-[#232730] bg-[#090a0c] py-20 lg:py-24" id="pillars">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Architectural Pillars
      </h2>
      <p class="mt-4 text-base sm:text-lg text-zinc-400 leading-relaxed">
        Reptar replaces enterprise ceremony with explicit, source-generated primitives.
        Everything runs inside the Worker boundary with zero reflection overhead.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature) => (
        <div class="rounded border border-[#232730] bg-[#111317] p-5 flex flex-col justify-between hover:border-zinc-700 transition-colors">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex h-8 w-8 items-center justify-center rounded bg-[#161a22] text-emerald-400 border border-[#232730]">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={feature.icon} />
                </svg>
              </span>
            </div>
            <h3 class="text-sm font-semibold text-white tracking-tight">{feature.title}</h3>
            <p class="mt-2 text-xs text-zinc-400 leading-relaxed">{feature.description}</p>
          </div>
          <div class="mt-5 pt-3 border-t border-[#1a1d24] font-mono text-[11px] text-zinc-500 truncate">
            {feature.code}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
