---
const features = [
  {
    code: "[ReptarEntity] + Tuple Params",
    description:
      "Compile-time source generators emit positional DbDataReader mappers and IReptarEntity write binders with zero reflection. Pass query parameters via stack-allocated value tuples (\"id\", id) and batch writes across D1, SQLite, PostgreSQL, and MySQL.",
    title: "Source-Generated Data Layer",
  },
  {
    code: "app.UseScalar() + Rule<T>()",
    description:
      "Routes registered with Validator<T> rules (.Min(), .Max(), .Email()) automatically populate OpenAPI 3.1 JSON Schemas. Serve interactive Scalar docs at /reference or Swagger UI at /swagger in one line.",
    title: "Auto-Derived OpenAPI 3.1",
  },
  {
    code: "CacheControl.SWR(15, 30)",
    description:
      "Built-in Stale-While-Revalidate perimeter caching serves hot anonymous reads from memory in 2.6 ms p50 (up to 39,214 req/s) while refreshing stale entries asynchronously in the background.",
    title: "Perimeter SWR Caching",
  },
  {
    code: "RateLimit.SlidingWindow(60, 60)",
    description:
      "O(1) lock-free weighted sliding-window rate limiter. Emits standard IETF X-RateLimit-Limit, X-RateLimit-Remaining, X-RateLimit-Reset, and Retry-After headers without per-request list allocations.",
    title: "Sliding-Window Rate Limiting",
  },
  {
    code: "POST /v1/chat/completions",
    description:
      "Universal streaming LLM proxy with in-connection failover, SHA-256 prompt caching (0.196 ms hit), and Vercel AI SDK Data Stream protocol compatibility. Benchmarked at 28,499 req/s under 500 concurrent connections.",
    title: "AI Gateway & Streaming",
  },
  {
    code: "app.GetAiTools() + StreamingAgentHarness",
    description:
      "Turn your REST API into an autonomous Agent Harness. Auto-export routes with Validator<T> rules as tools, dispatch in-process, and drive multi-step execution loops with checkpoints and human approval rules.",
    title: "AI Tools & Agent Harness",
  },
  {
    code: "app.OnWebSocket(\"/rooms/{roomId}\")",
    description:
      "High-concurrency WebSocket rooms with presence awareness and write-behind SQLite group-commit persistence. Benchmarked at 0.32 ms p50 fanout latency across 500 concurrent connections (4,926 sockets/s ramp-up).",
    title: "Realtime Rooms & WebSockets",
  },
  {
    code: "Reptar.Auth + Better Auth",
    description:
      "Complete C# authentication slice and wire-compatible Better Auth server. Includes PBKDF2 password hashing, Google/GitHub OAuth 2.0 with PKCE, multi-device session revocation, and rep_live_... API keys.",
    title: "Built-in Auth & Better Auth",
  },
  {
    code: "ctx.WaitUntil(async () => ...)",
    description:
      "Serverless-safe background tasks inspired by Hono and FastAPI. Prevents Cloudflare Workers isolate freezing after response completion while dispatching unblocked to Kestrel thread pools.",
    title: "Serverless Background Tasks",
  },
  {
    code: "app.DefinePolicy<T> + ctx.Can<T>",
    description:
      "Declarative, reflection-free resource authorization inspired by AdonisJS Bouncer and Laravel Gates. Define granular ownership policies once at startup and evaluate them cleanly across route handlers.",
    title: "Declarative Resource Policies",
  },
  {
    code: "app.CreateTestClient()",
    description:
      "Sub-millisecond in-memory testing engine without TCP port bindings, socket churn, or OS firewall alerts. Test complete request, validation, authorization, and background task pipelines in-process.",
    title: "In-Memory Testing Engine",
  },
  {
    code: "-p:ReptarSqliteOnly=true",
    description:
      "Compile the exact same C# routes to netwasm0.1 for Cloudflare Workers or net10.0 Native AOT. Trimming unused database drivers produces a 10.4 MB standalone Linux binary that boots in 124 ms.",
    title: "Dual-Target Wasm & Native AOT",
  },
];
---

<section class="border-b border-[#222630] bg-[#0a0b0e] py-20 lg:py-24" id="pillars">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Core Primitives
      </h2>
      <p class="mt-3 text-base sm:text-lg text-zinc-400 leading-relaxed">
        Reptar replaces heavyweight dependency injection, reflection-based ORMs, and third-party middleware sprawl with cohesive, AOT-safe primitives built into the core framework.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 border border-[#222630] bg-[#0f1116] divide-y md:divide-y-0 md:divide-x divide-[#222630]">
      {features.slice(0, 4).map((feature) => (
        <div class="p-6 flex flex-col justify-between">
          <div>
            <h3 class="text-base font-semibold text-white tracking-tight">{feature.title}</h3>
            <p class="mt-2.5 text-xs text-zinc-400 leading-relaxed">{feature.description}</p>
          </div>
          <div class="mt-6 pt-3 border-t border-[#1b1f28] font-mono text-[11px] text-emerald-400 truncate">
            {feature.code}
          </div>
        </div>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 border-x border-b border-[#222630] bg-[#0f1116] divide-y md:divide-y-0 md:divide-x divide-[#222630]">
      {features.slice(4, 8).map((feature) => (
        <div class="p-6 flex flex-col justify-between">
          <div>
            <h3 class="text-base font-semibold text-white tracking-tight">{feature.title}</h3>
            <p class="mt-2.5 text-xs text-zinc-400 leading-relaxed">{feature.description}</p>
          </div>
          <div class="mt-6 pt-3 border-t border-[#1b1f28] font-mono text-[11px] text-emerald-400 truncate">
            {feature.code}
          </div>
        </div>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 border-x border-b border-[#222630] bg-[#0f1116] divide-y md:divide-y-0 md:divide-x divide-[#222630]">
      {features.slice(8, 12).map((feature) => (
        <div class="p-6 flex flex-col justify-between">
          <div>
            <h3 class="text-base font-semibold text-white tracking-tight">{feature.title}</h3>
            <p class="mt-2.5 text-xs text-zinc-400 leading-relaxed">{feature.description}</p>
          </div>
          <div class="mt-6 pt-3 border-t border-[#1b1f28] font-mono text-[11px] text-emerald-400 truncate">
            {feature.code}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
