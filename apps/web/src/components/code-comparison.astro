    <!-- Bottom summary bar -->
    <div class="mt-8 rounded border border-[#232730] bg-[#111317] p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-mono text-zinc-300">Contract Generator</span>
        <span class="text-zinc-600">|</span>
        <span class="text-xs text-zinc-400">
          Every route with <code class="text-zinc-200">.Produces&lt;T&gt;()</code> generates an accurate TypeScript RPC definition, Standard Schema validator, and OpenAPI spec.
        </span>
      </div>
      <a
        href="https://reptar-docs.rocktown-labs.workers.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-mono font-medium text-emerald-400 hover:text-emerald-300 transition-colors whitespace-nowrap"
      >
        Read Codegen Specs &rarr;
      </a>
    </div>
  </div>
</section>

<script>
  const tabButtons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const tabPanes = document.querySelectorAll<HTMLDivElement>(".code-tab");

  for (const btn of tabButtons) {
    btn.addEventListener("click", () => {
      const targetId = btn.dataset.target;
      if (!targetId) {
        return;
      }

      for (const b of tabButtons) {
        b.classList.remove("active", "bg-[#161a22]", "text-white");
        b.classList.add("bg-[#111317]", "text-zinc-400");
      }

      btn.classList.add("active", "bg-[#161a22]", "text-white");
      btn.classList.remove("bg-[#111317]", "text-zinc-400");

      for (const pane of tabPanes) {
        if (pane.id === targetId) {
          pane.classList.remove("hidden");
          pane.classList.add("grid");
        } else {
          pane.classList.add("hidden");
          pane.classList.remove("grid");
        }
      }
    });
  }
</script>
