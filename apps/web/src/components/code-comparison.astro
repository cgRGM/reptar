      <div class="rounded border border-[#232730] bg-[#0d0e12] overflow-hidden flex flex-col">
        <div class="flex items-center justify-between border-b border-[#232730] bg-[#111317] px-4 py-2.5">
          <span class="font-mono text-xs text-zinc-300 font-medium">packages/rpc/schemas.generated.ts</span>
