---
const csharpRoutes = `// Terse route slice: records + rules + handlers
public static class Posts
{
    public record CreatePost(string Title, string Content);
    public record Post(string Id, string Title, string Content, int Published, string CreatedAt);

    public static readonly Validator<CreatePost> CreateSchema = Rule<CreatePost>()
        .Prop(x => x.Title, r => r.Min(3).Max(120))
        .Prop(x => x.Content, r => r.Min(1));

    public static ReptarApp Routes() => Reptar()
        .Get("/", async c => c.Json(
            await c.Db.ListAsync<Post>(Schema.Posts, "where published = 1 order by created_at desc")))
            .Produces<Post[]>(200)

        .Get("/:id", async c =>
        {
            var post = await c.Db.GetAsync<Post>(Schema.Posts, c.Req.Param("id"));
            return post is null
                ? c.Json(new { error = "Not found" }, 404)
                : c.Json(post);
        })
            .Produces<Post>(200)
            .Produces<ErrorBody>(404)

        .Post("/", CreateSchema, async (c, input) =>
        {
            var post = new Post(Ids.New("post"), input.Title, input.Content, 0, c.Clock.IsoNow());
            await c.Db.InsertAsync(Schema.Posts, post);
            return c.Json(post, 201);
        })
            .Produces<Post>(201)
            .Produces<ValidationError>(400);
}`;

const tsClient = `// Generated typed fetch client (~100 lines runtime)
import { createClient } from "@reptar/client";
import type { AppType } from "@reptar/rpc";

export const api = createClient<AppType>(import.meta.env.VITE_API_URL);

// 1. GET /posts — typed automatically as Post[]
const posts = await api.posts.$get();

// 2. GET /posts/:id — typed params, returns Post | null
const post = await api.posts[":id"].$get({
  param: { id: "post_01J8F" },
});

// 3. POST /posts — validates input before wire transfer
const res = await api.posts.$post({
  json: {
    title: "Production C# on Workers",
    content: "NetWasm engine with zero runtime reflection.",
  },
});

if (res.ok) {
  const row = await res.json(); // typed Post
  console.log("Inserted post ID:", row.Id);
}`;

const csharpSchema = `// Source of truth for DDL, D1 queries, and mappers
public static partial class Schema
{
    public static readonly TableDef Posts = DefineTable("posts", new
    {
        Id        = Col.Text("id").PrimaryKey(),
        AuthorId  = Col.Text("author_id").NotNull()
                       .References(Users, "id", onDelete: "cascade"),
        Slug      = Col.Text("slug").NotNull().Unique(),
        Title     = Col.Text("title").NotNull(),
        Content   = Col.Text("content").NotNull(),
        Published = Col.Int("published").Default(0),
        CreatedAt = Col.Text("created_at").DefaultSql("CURRENT_TIMESTAMP")
    });
}`;

const sqlDdl = `-- Generated by: reptar db generate
CREATE TABLE IF NOT EXISTS posts (
  id TEXT PRIMARY KEY,
  author_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  slug TEXT NOT NULL UNIQUE,
  title TEXT NOT NULL,
  content TEXT NOT NULL,
  published INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_posts_author ON posts(author_id);
CREATE INDEX IF NOT EXISTS idx_posts_published ON posts(published);`;

const csharpValidation = `// Built-in zero-dependency backend validation
public record SignUpInput(string Email, string Password);

public static readonly Validator<SignUpInput> SignUpSchema = Rule<SignUpInput>()
    .Prop(x => x.Email, r => r.Email().Max(255))
    .Prop(x => x.Password, r => r.Min(8).Max(128))
    .Refine(
        x => !x.Password.Contains(x.Email),
        "Password cannot contain email",
        path: "password"
    );`;

const tsStandardSchema = `// Zero runtime dependencies — speaks ~standard specification
import type { StandardSchemaV1 } from "@standard-schema/spec";

export const signUpSchema: StandardSchemaV1<SignUpInput> = {
  "~standard": {
    version: 1,
    vendor: "reptar",
    validate(value) {
      // Direct integration with TanStack Form, Formik, etc.
      return runValidator(value, {
        email: [{ type: "email" }, { type: "max", value: 255 }],
        password: [{ type: "min", value: 8 }, { type: "max", value: 128 }]
      });
    }
  }
};`;
---

<section class="border-b border-[#232730] bg-[#090a0c] py-20 lg:py-24" id="comparison">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        What you write, what you get
      </h2>
      <p class="mt-4 text-base sm:text-lg text-zinc-400 leading-relaxed">
        One feature file in C# defines the records, rules, and endpoints. The framework source-generates
        the route tree, serialization mappers, and a lightweight typed client for any frontend.
      </p>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="mt-8 flex flex-wrap gap-2">
      <button
        type="button"
        class="tab-btn active px-3.5 py-1.5 text-xs font-mono font-medium rounded border border-[#232730] bg-[#161a22] text-white hover:bg-[#1e232d] transition-colors"
        data-target="tab-routes"
      >
        01. Endpoints & Typed RPC
      </button>
      <button
        type="button"
        class="tab-btn px-3.5 py-1.5 text-xs font-mono font-medium rounded border border-[#232730] bg-[#111317] text-zinc-400 hover:text-white hover:bg-[#161a22] transition-colors"
        data-target="tab-schema"
      >
        02. Schema & SQL DDL
      </button>
      <button
        type="button"
        class="tab-btn px-3.5 py-1.5 text-xs font-mono font-medium rounded border border-[#232730] bg-[#111317] text-zinc-400 hover:text-white hover:bg-[#161a22] transition-colors"
        data-target="tab-validation"
      >
        03. Rules & Standard Schema
      </button>
    </div>

    <!-- Tab 1: Endpoints & Typed RPC -->
    <div id="tab-routes" class="code-tab mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- C# Backend -->
      <div class="rounded border border-[#232730] bg-[#0d0e12] overflow-hidden flex flex-col">
        <div class="flex items-center justify-between border-b border-[#232730] bg-[#111317] px-4 py-2.5">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-zinc-600"></span>
            <span class="font-mono text-xs text-zinc-300 font-medium">apps/api/features/posts.cs</span>
          </div>
          <span class="font-mono text-[11px] text-emerald-400 font-semibold uppercase tracking-wider">C# Backend</span>
        </div>
        <div class="p-4 font-mono text-xs leading-relaxed overflow-x-auto text-zinc-300">
          <pre><code>{csharpRoutes}</code></pre>
        </div>
      </div>

      <!-- TypeScript Client -->
      <div class="rounded border border-[#232730] bg-[#0d0e12] overflow-hidden flex flex-col">
        <div class="flex items-center justify-between border-b border-[#232730] bg-[#111317] px-4 py-2.5">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-zinc-600"></span>
            <span class="font-mono text-xs text-zinc-300 font-medium">apps/frontend/src/api.ts</span>
          </div>
          <span class="font-mono text-[11px] text-emerald-400 font-semibold uppercase tracking-wider">Frontend Client</span>
        </div>
