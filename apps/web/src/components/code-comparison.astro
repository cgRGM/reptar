        Decorating a C# record with <code class="font-mono text-zinc-200">[ReptarEntity]</code> generates a compile-time <code class="font-mono text-zinc-200">IDataRecordMapper&lt;T&gt;</code> with positional ordinal fast-paths, eliminating runtime reflection on both Wasm and Native AOT.
      </div>
      <a
        href="https://reptar-docs.rocktownlabs.app/client/codegen"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-mono font-medium text-emerald-400 hover:text-emerald-300 transition-colors whitespace-nowrap"
      >
        Explore Codegen &amp; OpenAPI &rarr;
      </a>
    </div>
  </div>
</section>

<script>
  const tabButtons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const tabPanes = document.querySelectorAll<HTMLDivElement>(".code-tab");

  for (const btn of tabButtons) {
    btn.addEventListener("click", () => {
      const targetId = btn.dataset.target;
      if (!targetId) {
        return;
      }

      for (const b of tabButtons) {
        b.classList.remove("active", "bg-[#161922]", "text-white");
        b.classList.add("bg-[#0f1116]", "text-zinc-400");
      }

      btn.classList.add("active", "bg-[#161922]", "text-white");
      btn.classList.remove("bg-[#0f1116]", "text-zinc-400");

      for (const pane of tabPanes) {
        if (pane.id === targetId) {
          pane.classList.remove("hidden");
          pane.classList.add("grid");
        } else {
          pane.classList.add("hidden");
          pane.classList.remove("grid");
        }
      }
    });
  }
</script>
