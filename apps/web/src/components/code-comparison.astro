---
const csharpRoutes = `// Zero-reflection entity + rules + typed route handlers
[ReptarEntity]
public record Post(string Id, string Title, string Content, int Published, string CreatedAt);
public record CreatePost(string Title, string Content);

public static class Posts
{
    public static readonly Validator<CreatePost> CreateSchema = Rule<CreatePost>()
        .Prop(x => x.Title, r => r.Min(3).Max(120))
        .Prop(x => x.Content, r => r.Min(1));

    public static void Configure(ReptarApp app)
    {
        app.Get("/posts", async c => c.Json(
            await c.Db.QueryAsync<Post>(
                "SELECT id, title, content, published, created_at FROM posts WHERE published = @pub ORDER BY created_at DESC",
                ("pub", 1))))
            .WithSummary("List published posts")
            .WithTags("Posts")
            .Produces<Post[]>(200);

        app.Get("/posts/:id", async c =>
        {
            var post = await c.Db.QuerySingleOrDefaultAsync<Post>(
                "SELECT id, title, content, published, created_at FROM posts WHERE id = @id",
                ("id", c.Req.Param("id")));
            return post is null ? c.NotFound() : c.Json(post);
        })
            .Produces<Post>(200)
            .Produces<ErrorBody>(404);

        app.Post("/posts", CreateSchema, async (c, input) =>
        {
            var post = new Post(Ids.New("post"), input.Title, input.Content, 1, c.Clock.IsoNow());
            await c.Db.InsertAsync(Schema.Posts, post);
            return c.Json(post, 201);
        })
            .Produces<Post>(201)
            .Produces<ValidationError>(400);
    }
}`;

const tsClient = `// Generated typed fetch client (~100 lines runtime, 0 dependencies)
import { createClient } from "@reptar/client";
import type { AppType } from "@reptar/rpc";

export const api = createClient<AppType>(import.meta.env.VITE_API_URL);

// 1. GET /posts — typed automatically as Post[]
const listRes = await api.posts.$get();
if (listRes.ok) {
  const posts = await listRes.json();
}

// 2. GET /posts/:id — typed path params, returns Post | ErrorBody
const detailRes = await api.posts[":id"].$get({
  param: { id: "post_01J8F" },
});

// 3. POST /posts — compile-time checked input & response
const createRes = await api.posts.$post({
  json: {
    title: "Production C# on Workers",
    content: "Zero runtime reflection with [ReptarEntity] positional mappers.",
  },
});

if (createRes.ok) {
  const created = await createRes.json(); // typed Post
}`;

const csharpSchema = `// Single source of truth for DDL, migrations, and CRUD
public static partial class Schema
{
    public static readonly TableDef Posts = DefineTable("posts",
        Col.Text("id").PrimaryKey(),
        Col.Text("author_id").NotNull()
           .References("users", "id", onDelete: "cascade"),
        Col.Text("slug").NotNull().Unique(),
        Col.Text("title").NotNull(),
        Col.Text("content").NotNull(),
        Col.Int("published").Default(0),
        Col.Text("created_at").DefaultSql("CURRENT_TIMESTAMP")
    );
}

// Transactional pipelined batching across D1, SQLite, Postgres & MySQL
await c.Db.BatchAsync(
    ("INSERT INTO posts (id, author_id, slug, title, content) VALUES (@id, @author, @slug, @title, @body)",
        new object?[] { ("id", postId), ("author", userId), ("slug", slug), ("title", title), ("body", body) }),
    ("INSERT INTO post_tags (post_id, tag) VALUES (@id, @tag)",
        new object?[] { ("id", postId), ("tag", "csharp") })
);`;

const sqlDdl = `-- Managed via CLI:
-- $ bun scripts/reptar.ts db new add_posts_table
-- $ bun scripts/reptar.ts db status
-- $ bun scripts/reptar.ts db migrate

CREATE TABLE IF NOT EXISTS posts (
  id TEXT PRIMARY KEY,
  author_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  slug TEXT NOT NULL UNIQUE,
  title TEXT NOT NULL,
  content TEXT NOT NULL,
  published INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_posts_author ON posts(author_id);
CREATE INDEX IF NOT EXISTS idx_posts_published ON posts(published);`;

const csharpStreamingAndOpenApi = `// Native SSE streaming, SWR caching, and OpenAPI 3.1 + Scalar UI
var app = ReptarApp.Create(new ReptarConfig { Database = Db.Sqlite("app.db") });

// 1. Sub-3ms Stale-While-Revalidate perimeter cache + O(1) Sliding Window Rate Limit
app.Use(CacheControl.SWR(ttlSeconds: 15, swrSeconds: 30));
app.Use(RateLimit.SlidingWindow(limit: 100, windowSeconds: 60));

// 2. Zero-reflection OpenAPI 3.1 spec + interactive Scalar UI at /reference
app.UseScalar(title: "Reptar Production API", version: "1.0.0");

// 3. Channel<byte[]>-backed Server-Sent Events (SSE) for AI token streaming
app.Get("/api/ai/stream", c => Task.FromResult(
    c.Sse(async stream =>
    {
        await stream.SendAsync("connected", @event: "status");
        await stream.SendJsonAsync(new { token = "Reptar " }, @event: "delta");
        await stream.SendJsonAsync(new { token = "streams at zero alloc." }, @event: "delta");
        await stream.SendAsync("[DONE]", @event: "done");
    })
));`;

const openApiOutput = `// Auto-derived from RouteMeta + Validator<T> at GET /openapi.json
{
  "openapi": "3.1.0",
  "info": { "title": "Reptar Production API", "version": "1.0.0" },
  "paths": {
    "/posts": {
      "post": {
        "summary": "Create a new post",
        "tags": ["Posts"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "content"],
                "properties": {
                  "title": { "type": "string", "minLength": 3, "maxLength": 120 },
                  "content": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}`;
---

<section class="border-b border-[#222630] bg-[#0a0b0e] py-20 lg:py-24" id="comparison">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          What you write, what you get
        </h2>
        <p class="mt-3 text-base sm:text-lg text-zinc-400 leading-relaxed">
          One C# feature slice defines your entities, validation rules, and route handlers. Source generators emit positional SQLite/Postgres mappers, TypeScript RPC clients, and OpenAPI 3.1 schemas at build time.
        </p>
      </div>

      <!-- Mode Selector Tabs -->
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          class="tab-btn active px-3.5 py-2 text-xs font-mono font-medium border border-[#222630] bg-[#161922] text-white transition-colors"
          data-target="tab-routes"
        >
          01. Endpoints &amp; Typed RPC
        </button>
        <button
          type="button"
          class="tab-btn px-3.5 py-2 text-xs font-mono font-medium border border-[#222630] bg-[#0f1116] text-zinc-400 hover:text-white transition-colors"
          data-target="tab-schema"
        >
          02. Schema, Batching &amp; Migrations
        </button>
        <button
          type="button"
          class="tab-btn px-3.5 py-2 text-xs font-mono font-medium border border-[#222630] bg-[#0f1116] text-zinc-400 hover:text-white transition-colors"
          data-target="tab-streaming"
        >
          03. SSE, SWR &amp; OpenAPI 3.1
