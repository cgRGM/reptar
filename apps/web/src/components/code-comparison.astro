      </div>
    </div>

    <!-- Tab 1: Endpoints & Typed RPC -->
    <div id="tab-routes" class="code-tab mt-8 grid grid-cols-1 lg:grid-cols-2 border border-[#222630] bg-[#0d0f14] divide-y lg:divide-y-0 lg:divide-x divide-[#222630]">
      <div class="flex flex-col overflow-hidden">
        <div class="flex items-center justify-between border-b border-[#222630] bg-[#13161c] px-4 py-2.5">
          <span class="font-mono text-xs text-zinc-200 font-medium">apps/api/features/posts.cs</span>
          <span class="font-mono text-xs text-zinc-500">C# Backend</span>
