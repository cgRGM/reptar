---
---

<footer class="border-t border-[#232730] bg-[#090a0c] py-12 lg:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5">
          <svg class="h-5 w-5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M21 4h-6v2h-2v2h-2V6H9V4H5v4h2v4h2v2H7v2H5v2H3v4h4v-2h2v-2h2v-2h2v4h2v-4h2v-2h2v-4h2V8h-2V6h2V4z" />
          </svg>
          <span class="font-bold tracking-tight text-white text-base">reptar</span>
        </div>
        <p class="mt-3 text-xs text-zinc-400 leading-relaxed max-w-sm">
          A C# web framework compiled to WebAssembly for Cloudflare Workers.
          Minimal NetWasm runtime, zero reflection, built-in validation, and generated typed contracts.
        </p>
        <div class="mt-4 font-mono text-[11px] text-zinc-500">
          Reptar is the backend. Full stop.
        </div>
      </div>

      <!-- Col 2: Documentation -->
      <div>
        <h4 class="font-mono text-xs font-semibold text-zinc-300 uppercase tracking-wider">
          Documentation
        </h4>
        <ul class="mt-3 space-y-2 text-xs text-zinc-400">
          <li>
            <a href="http://localhost:4322" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              Getting Started
            </a>
          </li>
          <li>
            <a href="http://localhost:4322" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              Architecture & Lifecycle
            </a>
          </li>
          <li>
            <a href="http://localhost:4322" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              Routing & Endpoints
            </a>
          </li>
          <li>
            <a href="http://localhost:4322" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              Schema & Migrations
            </a>
          </li>
          <li>
            <a href="http://localhost:4322" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              Cloudflare Bindings
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Resources -->
      <div>
        <h4 class="font-mono text-xs font-semibold text-zinc-300 uppercase tracking-wider">
          Community & Source
        </h4>
        <ul class="mt-3 space-y-2 text-xs text-zinc-400">
          <li>
            <a href="https://github.com/RocktownLabs/reptar" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              GitHub Repository
            </a>
          </li>
          <li>
            <a href="https://github.com/RocktownLabs/reptar/blob/master/design.md" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              Design Specification
            </a>
          </li>
          <li>
            <a href="https://developers.cloudflare.com/workers/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              Cloudflare Workers
            </a>
          </li>
          <li>
            <a href="https://alchemy.run" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              Alchemy Infrastructure
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom sub-bar -->
    <div class="border-t border-[#1a1d24] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 font-mono">
      <div>
        &copy; {new Date().getFullYear()} Rocktown Labs. Open source under the MIT License.
      </div>
      <div>
        Built with C# + NetWasm on Cloudflare Workers.
      </div>
    </div>
  </div>
</footer>
