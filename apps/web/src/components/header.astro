---
const links = [
  { href: "#comparison", label: "Code" },
  { href: "#benchmarks", label: "Benchmarks" },
  { href: "#architecture", label: "Architecture" },
  { href: "#pillars", label: "Primitives" },
  { href: "#usage", label: "Targets" },
  { href: "/blog", label: "Live Demo" },
  {
    external: true,
    href: "https://reptar-docs.rocktownlabs.app",
    label: "Docs",
  },
];
---

<header class="sticky top-0 z-50 w-full border-b border-[#222630] bg-[#0a0b0e]">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2.5" aria-label="Reptar Home">
        <svg class="h-5 w-5 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21 4h-6v2h-2v2h-2V6H9V4H5v4h2v4h2v2H7v2H5v2H3v4h4v-2h2v-2h2v-2h2v4h2v-4h2v-2h2v-4h2V8h-2V6h2V4z" />
        </svg>
        <span class="font-bold tracking-tight text-white text-base">reptar</span>
        <span class="bg-[#13161c] px-1.5 py-0.5 font-mono text-[11px] font-medium text-zinc-400 border border-[#222630]">
          v0.2
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-6" aria-label="Main Navigation">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class="text-sm font-medium text-zinc-400 hover:text-white transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/login"
        class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-zinc-400 hover:text-white transition-colors"
      >
        Sign in
      </a>

      <a
        href="https://github.com/cgRGM/reptar"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-zinc-200 border border-[#222630] bg-[#0f1116] hover:bg-[#161920] hover:text-white transition-colors"
        aria-label="GitHub Repository"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
      </a>

      <a
        href="https://reptar-docs.rocktownlabs.app"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-3.5 py-1.5 text-xs font-semibold text-zinc-950 bg-emerald-500 hover:bg-emerald-400 transition-colors"
      >
        Read Docs
      </a>
    </div>
  </div>
</header>
