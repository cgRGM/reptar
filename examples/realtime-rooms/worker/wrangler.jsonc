{
  "name": "reptar-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomsHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomsHub"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reptar-rooms-local",
      "database_id": "local"
    }
  ]
}
