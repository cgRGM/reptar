<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework>netwasm0.1</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefineConstants>NETWASM</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Reptar</AssemblyName>
    <RootNamespace>Reptar</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Reptar/Core/**/*.cs" />
    <!-- Native-only surfaces: not reachable from the Worker request path and
         they add measurable O0 module size. -->
    <Compile Remove="../Reptar/Core/AiTools.cs" />
    <Compile Remove="../Reptar/Core/OpenApi.cs" />
    <Compile Include="../Reptar/Validation/**/*.cs" />
    <Compile Include="../Reptar/Queue/QueuePort.cs" />
    <Compile Include="../Reptar/Queue/SyncQueueClient.cs" />
    <Compile Include="../Reptar/Data/ReptarEntityAttribute.cs" />
    <Compile Include="../Reptar/Data/ColumnRef.cs" />
    <Compile Include="../Reptar/Data/BufferedTransaction.cs" />
    <Compile Include="../Reptar/Data/Preload.cs" />
    <Compile Include="../Reptar/Data/Services.cs" />
    <Compile Include="../Reptar/Data/SqlParamParser.cs" />
    <Compile Include="Data/TableDef.Wasm.cs" />
    <Compile Include="Data/WorkerHost.cs" />
    <Compile Include="Data/TelemetryLogger.cs" />
    <Compile Include="Data/D1DbClient.cs" />
    <Compile Include="Data/R2Client.cs" />
    <Compile Include="Data/WasmCrypto.cs" />
    <Compile Include="Data/WasmEnvironment.cs" />
    <Compile Include="Data/WasmWebSocketTransport.cs" />
    <Compile Include="Data/WasmHttpClient.cs" />
    <Compile Include="Data/KvClient.cs" />
    <Compile Include="Data/AiClient.cs" />
    <Compile Include="Data/QueueClient.cs" />
    <Compile Include="Data/DurableBridge.cs" />
    <Compile Include="Auth/Auth.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetWasm.System.Linq" Version="0.10.0" />
    <PackageReference Include="NetWasm.System.Text.Json" Version="0.10.0" />
  </ItemGroup>
</Project>
