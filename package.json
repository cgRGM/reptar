{
  "name": "reptar",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "spikes/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.18.0",
      "@cloudflare/workers-types": "^5.20260906.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=docs --filter=@reptar/workers-blog-demo",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev:bare -F web --",
    "dev:docs": "turbo run dev -F docs --",
    "api:dev": "bun scripts/reptar.ts dev",
    "api:build": "bun scripts/reptar.ts build",
    "api:test": "bun scripts/reptar.ts test",
    "api:codegen": "bun scripts/reptar.ts codegen",
    "rpc:gen": "bun scripts/reptar.ts codegen",
    "rpc:check": "bunx tsc --noEmit -p examples/blog/rpc",
    "deploy": "turbo run deploy -F @reptar/infra --",
    "destroy": "turbo run destroy -F @reptar/infra --",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "dev:api": "turbo run dev -F @reptar/workers-blog-demo"
  },
  "dependencies": {
    "@reptar/client": "workspace:*",
    "cookie": "^2.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@reptar/config": "workspace:*",
    "@types/node": "^26.4.1",
    "lefthook": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.10"
}
