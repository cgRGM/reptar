{
  "name": "reptar",
  "private": true,
  "bin": {
    "reptar": "./scripts/reptar.ts"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "examples/*/worker",
      "packages/*",
      "spikes/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.18.0",
      "@cloudflare/workers-types": "^5.20260906.1"
    }
  },
  "type": "module",
  "scripts": {
    "reptar": "bun scripts/reptar.ts",
    "dev": "turbo run dev --filter=web --filter=docs --filter=@reptar/workers-blog-demo",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev:bare -F web --",
    "dev:docs": "turbo run dev -F docs --",
    "api:dev": "bun scripts/reptar.ts dev",
    "realworld:dev": "bun scripts/reptar.ts realworld:dev",
    "baas:dev": "bun scripts/reptar.ts baas:dev",
    "baas:seed": "bun examples/baas/seed.ts",
    "baas:test": "bun scripts/reptar.ts baas:test",
    "baas:bench": "bun examples/baas/bench.ts",
    "gateway:dev": "bun scripts/reptar.ts gateway:dev",
    "gateway:bench": "bun examples/ai-gateway/bench.ts",
    "agent:dev": "bun scripts/reptar.ts agent",
    "rooms:dev": "bun scripts/reptar.ts rooms:dev",
    "rooms:smoke": "bun examples/realtime-rooms/smoke.ts",
    "rooms:bench": "bun examples/realtime-rooms/bench.ts",
    "jobs:dev": "bun --cwd examples/jobs run app.cs",
    "jobs:bench": "bun examples/jobs/bench.ts",
    "check:netwasm": "bun scripts/reptar.ts check:netwasm",
    "check:host": "bun scripts/reptar.ts check:host",
    "check:worker": "bun scripts/reptar.ts check:worker",
    "check:architecture": "bun scripts/check-architecture.ts --strict",
    "check:size": "bun scripts/check-size.ts",
    "bench:gate": "bun scripts/bench-gate.ts",
    "test:realtime": "bun scripts/reptar.ts test:realtime",
    "test:providers": "bun scripts/test-providers.ts",
    "dev:status": "bun scripts/reptar.ts dev:status",
    "self-check": "bun scripts/reptar.ts self-check",
    "realworld:worker:build": "bun scripts/reptar.ts build:realworld",
    "realworld:worker:dev": "bun --cwd spikes/realworld-worker dev",
    "realworld:hurl": "bun scripts/realworld-hurl.ts",
    "realworld:bench": "bun scripts/bench-realworld.ts",
    "api:build": "bun scripts/reptar.ts build",
    "worker:build": "bun scripts/reptar.ts build:worker",
    "api:test": "bun scripts/reptar.ts test",
    "api:bench": "bun scripts/benchmark.ts",
    "bench:seed": "bun bench/shared/seed.ts",
    "bench:validation": "bun scripts/bench-validation.ts",
    "bench:load": "bun bench/load/run.ts",
    "bench:mixed": "bun bench/load/mixed.ts",
    "bench:report": "bun bench/load/report.ts",
    "e2e": "bun scripts/e2e.ts",
    "test:scaffold": "bun scripts/test-scaffold.ts",
    "test:host": "bun test packages/host/src",
    "api:codegen": "bun scripts/reptar.ts codegen",
    "rpc:gen": "bun scripts/reptar.ts codegen",
    "rpc:check:generated": "bun scripts/reptar.ts codegen --check",
    "rpc:check": "bun scripts/reptar.ts codegen --check && bunx tsc --noEmit -p examples/blog/rpc",
    "docs:check:snippets": "bun scripts/check-doc-snippets.ts",
    "deploy": "cd packages/infra && bun run deploy",
    "destroy": "turbo run destroy -F @reptar/infra --",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "dev:api": "turbo run dev -F @reptar/workers-blog-demo"
  },
  "dependencies": {
    "@reptar/client": "workspace:*",
    "cookie": "^2.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@reptar/cli-core": "workspace:*",
    "@reptar/config": "workspace:*",
    "@types/node": "^26.6.5",
    "lefthook": "latest",
    "miniflare": "4.20260730.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.89.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "hono": "4.13.14",
    "lodash": "4.18.1",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "valibot": "1.5.0"
  },
  "packageManager": "bun@1.3.10"
}
