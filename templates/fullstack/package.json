{
  "name": "{{PROJECT_NAME}}",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "api:dev": "bun scripts/reptar.ts dev",
    "api:codegen": "bun scripts/reptar.ts codegen",
