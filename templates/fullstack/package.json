    "json:gen": "bun scripts/reptar.ts json:gen"
  },
  "devDependencies": {
    "@reptar/cli-core": "workspace:*",
    "turbo": "^2.11.10",
    "typescript": "^5.7.3"
  },
  "packageManager": "bun@1.3.10"
